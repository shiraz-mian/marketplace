PORT=5000
MONGODB_URI="replace with your private Atlas connection string"
MONGODB_DB_NAME=marketplace
JWT_SECRET=""
JWT_ISSUER=marketplace-api
JWT_AUDIENCE=marketplace-client
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional until image uploads are enabled. Keep real credentials private.
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # Only for temporary credentials

# Local Elasticsearch. Production requires HTTPS; keep API keys on the server.
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=marketplace-products-v1
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_SERVERLESS=false

# Cart storage. Local development defaults to this address; use rediss:// in production.
REDIS_URL=redis://127.0.0.1:6379
REDIS_CART_PREFIX=marketplace:cart

# Razorpay TEST MODE only. Standard checkout does not require Route access.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYMENT_FLOW=standard
# Use route only after Route access and vendor linked accounts are ready.
COMMISSION_BPS=1000
